{
  "name": "zanzibar-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,mjs}\"",
    "check": "pnpm run check-types && pnpm run lint && pnpm run format:check",
    "db:generate": "pnpm --filter @zanzibar-app/db generate",
    "db:migrate": "pnpm --filter @zanzibar-app/db migrate",
    "db:studio": "pnpm --filter @zanzibar-app/db studio",
    "preview:web": "pnpm --filter @zanzibar-app/db build && pnpm --filter @zanzibar-app/web cf:preview",
    "deploy:web": "pnpm --filter @zanzibar-app/db build && pnpm --filter @zanzibar-app/web cf:deploy"
  },

  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript-eslint": "^8.72.2"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
